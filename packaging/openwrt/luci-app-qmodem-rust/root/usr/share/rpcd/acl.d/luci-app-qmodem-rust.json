{
  "luci-app-qmodem-rust": {
    "description": "Control the QModem Rust service",
    "read": {
      "ubus": {
        "rc": [
          "list"
        ],
        "service": [
          "list"
        ],
        "file": [
          "exec"
        ]
      },
      "file": {
        "/usr/sbin/qmodemd --config /etc/qmodem-rust.toml service-info": [
          "exec"
        ],
        "/usr/sbin/qmodemd --config /etc/qmodem-rust.toml interfaces": [
          "exec"
        ]
      }
    },
    "write": {
      "ubus": {
        "rc": [
          "init"
        ],
        "file": [
          "exec"
        ]
      },
      "file": {
        "/usr/sbin/qmodemd --config /etc/qmodem-rust.toml set-service --listen * --port * --interface * --log-level * --log-format *": [
          "exec"
        ],
        "/usr/sbin/qmodemd --config /etc/qmodem-rust.toml init-auth": [
          "exec"
        ]
      }
    }
  }
}
