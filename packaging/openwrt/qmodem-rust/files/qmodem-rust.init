#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    /usr/sbin/qmodemd --config /etc/qmodem-rust.toml check || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/qmodemd --config /etc/qmodem-rust.toml serve
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/qmodem-rust.toml
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    /usr/sbin/qmodemd --config /etc/qmodem-rust.toml check || return 1
    stop
    start
}

# rc.common calls this only for system shutdown, not ordinary service restarts.
shutdown() {
    stop
    /usr/sbin/qmodemd --config /etc/qmodem-rust.toml shutdown
}
